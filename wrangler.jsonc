{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-webhook",
	"main": "server/index.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cf_webhook_db",
			"database_id": "af8e24e1-5515-4083-85dd-df928156e545"
		}
	],
	"routes": [
		{
			"pattern": "webhook.b1uegrey.xyz",
			"custom_domain": true
		}
	]
}